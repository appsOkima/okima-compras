# Copia este archivo como .env.seed (queda fuera de git) y completa los valores.
# Solo lo usa scripts/seed-usuarios.mjs: node --env-file=.env.seed scripts/seed-usuarios.mjs
# La service-role key NUNCA va en .env.local ni con prefijo VITE_ (quedaría en el navegador).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEED_PASSWORD=
