# Copiar a .env.local y completar con los datos del proyecto en Supabase:
# Project Settings → API (o Data API) → Project URL y la clave pública.
# La clave pública puede ser la "publishable key" (sb_publishable_...) o la
# "anon key" heredada; ambas usan el rol anon, que es el que habilita el RLS.
# Nunca poner aquí la service_role / secret key: queda expuesta en el navegador.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
